# Alles ist optional. Ohne diese Werte läuft die App im Demo-Modus
# (eingebaute Datenbank, SMS werden nur angezeigt statt verschickt).

# Geheimer Schlüssel für Login-Cookies (beliebige lange Zufallszeichenkette)
AUTH_SECRET=

# Supabase-Datenbank (Projekt-Einstellungen -> Database -> Connection string, "Transaction pooler")
DATABASE_URL=

# seven.io API-Schlüssel für echte SMS
SEVEN_API_KEY=

# Öffentliche Adresse der App, z. B. https://kommt-gleich.de (für den Link in der SMS)
APP_URL=

# Schutz für den Zeitplan-Aufruf /api/cron
CRON_SECRET=

# Kontakt-Adresse von Lukas Technology für "Website bauen lassen" in den Einstellungen.
# Solange leer, wird der Knopf nicht angezeigt.
KONTAKT_EMAIL=
